{
  // 이 사이트는 SSR 없이 dist/를 그대로 서빙하는 정적 사이트다.
  // 설정 파일이 없으면 wrangler deploy가 자동 설정(astro add cloudflare)을 실행해
  // SSR 어댑터를 설치하고 astro.config를 고쳐 빌드를 다시 돌린다 → 빌드 실패.
  // 이 파일이 있으면 그 자동 설정 단계를 건너뛴다.
  "name": "adsense",
  "compatibility_date": "2026-09-03",

  // Worker 스크립트 없이 정적 자산만 배포
  "assets": {
    "directory": "./dist"
  }
}
