---
// box-shadow 생성기 (여러 레이어 지원)
import ToolPage from '../../layouts/ToolPage.astro';
---

<ToolPage slug="box-shadow-generator">
  <div class="shadow-layout">
    {/* 다른 도구와 같은 순서: 컨트롤 → 결과 */}
    <div>
      <div class="layer-controls">
        <div class="layer-head">
          <span class="section-label" style="margin:0;border:0;padding:0">그림자 레이어</span>
          <span class="layer-actions">
            <button type="button" class="btn" id="undo" disabled>실행취소</button>
            <button type="button" class="btn" id="reset">초기화</button>
            <button type="button" class="btn" id="add-layer">+ 레이어 추가</button>
          </span>
        </div>
        <div id="layers"></div>
        <p class="form-actions">
          <small>값을 바꾸면 주소도 함께 바뀝니다. 그 주소를 공유하면 같은 그림자로 열립니다.</small>
        </p>
      </div>

      <div class="output">
        <div class="output-head">
          <span>결과</span>
          <button type="button" class="btn" id="copy">복사</button>
        </div>
        <code class="output-code" id="output"></code>
      </div>
    </div>

    <div class="preview shadow-preview">
      <span class="preview-label">미리보기</span>
      <div class="preview-stage" id="stage" data-bg="light">
        <div id="shadow-box"></div>
      </div>
      <div class="preview-toggle">
        <button type="button" class="btn" data-bg="light" aria-pressed="true">밝은 배경</button>
        <button type="button" class="btn" data-bg="dark" aria-pressed="false">어두운 배경</button>
      </div>
    </div>
  </div>

  <section>
    <h2>사용법</h2>
    <p>
      <code>box-shadow</code>는 <strong>가로 오프셋, 세로 오프셋, 흐림(blur),
      번짐(spread), 색상</strong> 순서로 값을 씁니다. 여기서는 여러 레이어를
      쉼표로 이어 붙여 겹칠 수 있습니다. 하나의 진한 그림자보다
      <strong>흐림과 투명도가 다른 그림자를 2~4겹 쌓으면</strong> 훨씬 자연스러운
      깊이감이 나옵니다.
    </p>
    <p>
      <strong>inset</strong>을 켜면 요소 안쪽으로 그림자가 들어가 눌린 느낌이나
      내부 경계선 효과를 줍니다. 색상은 보통 검정에 낮은 투명도(0.1~0.2)를 씁니다.
      완전 불투명한 회색보다 반투명 검정이 배경색과 자연스럽게 섞입니다.
    </p>
  </section>
</ToolPage>

<script>
  import { replaceQuery } from '../../scripts/tool-state';

  // box-shadow 레이어 관리 및 CSS 생성 (클라이언트에서만 실행)
  interface Layer {
    x: number;
    y: number;
    blur: number;
    spread: number;
    color: string;
    alpha: number;
    inset: boolean;
  }

  const layersEl = document.getElementById('layers')!;
  const output = document.getElementById('output')!;
  const box = document.getElementById('shadow-box')!;
  const addBtn = document.getElementById('add-layer') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy') as HTMLButtonElement;

  const undoBtn = document.getElementById('undo') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset') as HTMLButtonElement;

  const DEFAULT_LAYERS: Layer[] = [
    { x: 0, y: 1, blur: 2, spread: 0, color: '#000000', alpha: 0.12, inset: false },
    { x: 0, y: 8, blur: 24, spread: -4, color: '#000000', alpha: 0.14, inset: false },
  ];

  const clone = (ls: Layer[]) => ls.map((l) => ({ ...l }));

  let layers: Layer[] = clone(DEFAULT_LAYERS);

  // 레이어를 지우거나 되돌릴 수 있도록 직전 상태를 쌓아 둔다
  const undoStack: Layer[][] = [];
  function snapshot() {
    undoStack.push(clone(layers));
    if (undoStack.length > 20) undoStack.shift();
    undoBtn.disabled = false;
  }

  // 그림자 설정을 주소에 담아 링크로 공유할 수 있게 한다
  function encode(ls: Layer[]): string {
    return ls
      .map((l) =>
        [l.x, l.y, l.blur, l.spread, l.color.replace('#', ''), l.alpha, l.inset ? 1 : 0].join(','),
      )
      .join(';');
  }

  function decode(raw: string): Layer[] | null {
    const out: Layer[] = [];
    for (const part of raw.split(';')) {
      const f = part.split(',');
      if (f.length !== 7) return null;
      const [x, y, blur, spread, color, alpha, inset] = f;
      if (!/^[0-9a-fA-F]{3}$|^[0-9a-fA-F]{6}$/.test(color)) return null;
      const nums = [x, y, blur, spread, alpha].map(Number);
      if (nums.some((n) => Number.isNaN(n))) return null;
      out.push({
        x: nums[0],
        y: nums[1],
        blur: Math.max(0, nums[2]),
        spread: nums[3],
        color: '#' + color,
        alpha: Math.min(1, Math.max(0, nums[4])),
        inset: inset === '1',
      });
    }
    return out.length ? out : null;
  }

  function syncUrl() {
    const v = encode(layers);
    replaceQuery(v === encode(DEFAULT_LAYERS) ? '' : new URLSearchParams({ l: v }).toString());
  }

  function hexToRgb(hex: string): [number, number, number] {
    let h = hex.replace(/^#/, '');
    if (h.length === 3) h = h.split('').map((c) => c + c).join('');
    return [
      parseInt(h.slice(0, 2), 16) || 0,
      parseInt(h.slice(2, 4), 16) || 0,
      parseInt(h.slice(4, 6), 16) || 0,
    ];
  }

  function layerToCss(l: Layer): string {
    const [r, g, b] = hexToRgb(l.color);
    const rgba = `rgba(${r}, ${g}, ${b}, ${l.alpha})`;
    // blur 는 음수가 될 수 없음(CSS 규격)
    const blur = Math.max(0, l.blur);
    const parts = [
      l.inset ? 'inset' : '',
      `${l.x}px`,
      `${l.y}px`,
      `${blur}px`,
      `${l.spread}px`,
      rgba,
    ].filter(Boolean);
    return parts.join(' ');
  }

  function render() {
    // 컨트롤 UI 다시 그리기
    layersEl.innerHTML = '';
    layers.forEach((layer, i) => {
      const wrap = document.createElement('div');
      wrap.className = 'panel layer-row';
      wrap.innerHTML = `
        <div class="layer-row-head">
          <strong>레이어 ${i + 1}</strong>
          <button type="button" class="btn btn-remove" data-i="${i}" ${layers.length === 1 ? 'disabled' : ''}>삭제</button>
        </div>
        <div class="field-grid">
          <label class="field">X (px)<input class="control" type="number" data-i="${i}" data-k="x" value="${layer.x}"></label>
          <label class="field">Y (px)<input class="control" type="number" data-i="${i}" data-k="y" value="${layer.y}"></label>
          <label class="field">Blur (px)<input class="control" type="number" data-i="${i}" data-k="blur" min="0" value="${layer.blur}"></label>
          <label class="field">Spread (px)<input class="control" type="number" data-i="${i}" data-k="spread" value="${layer.spread}"></label>
          <label class="field">색상
            <span class="color-row">
              <input type="color" data-i="${i}" data-k="color" value="${layer.color}" aria-label="레이어 ${i + 1} 색상">
              <input class="control" type="text" data-i="${i}" data-k="colorText" value="${layer.color}" spellcheck="false" aria-describedby="color-err-${i}">
            </span>
            <small class="color-error is-error" id="color-err-${i}" hidden>#RRGGBB 형식으로 입력하세요.</small>
          </label>
          <label class="field">투명도 (${layer.alpha})
            <input class="control" type="range" data-i="${i}" data-k="alpha" min="0" max="1" step="0.01" value="${layer.alpha}">
          </label>
          <label class="field field-inline">
            <input type="checkbox" data-i="${i}" data-k="inset" ${layer.inset ? 'checked' : ''}> inset (안쪽 그림자)
          </label>
        </div>
      `;
      layersEl.appendChild(wrap);
    });

    refreshOutput();
  }

  function refreshOutput() {
    const css = layers.map(layerToCss).join(',\n            ');
    output.textContent = `box-shadow: ${css};`;
    (box as HTMLElement).style.boxShadow = layers.map(layerToCss).join(', ');
    syncUrl();
  }

  layersEl.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    const i = Number(el.dataset.i);
    const k = el.dataset.k;
    if (Number.isNaN(i) || !k) return;
    const layer = layers[i];

    if (k === 'inset') {
      layer.inset = el.checked;
    } else if (k === 'color') {
      layer.color = el.value;
      // 짝을 이루는 텍스트 입력도 동기화
      const text = el.parentElement!.querySelector<HTMLInputElement>('[data-k="colorText"]');
      if (text) text.value = el.value;
    } else if (k === 'colorText') {
      // 형식이 틀렸을 때 조용히 무시하면 입력값과 미리보기가 어긋난 채로 남는다
      const ok = /^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/.test(el.value);
      el.toggleAttribute('aria-invalid', !ok);
      const err = el.closest('.field')!.querySelector<HTMLElement>('.color-error');
      if (err) err.hidden = ok;
      if (ok) {
        layer.color = el.value;
        // 짝을 이루는 색상 선택기도 같이 맞춘다
        const pick = el.parentElement!.querySelector<HTMLInputElement>('[data-k="color"]');
        if (pick) pick.value = el.value;
      }
    } else if (k === 'alpha') {
      layer.alpha = Number(el.value);
      const label = el.closest('.field')!;
      label.childNodes[0].textContent = `투명도 (${layer.alpha}) `;
    } else {
      let n = Number(el.value);
      if (k === 'blur') n = Math.max(0, n); // blur 음수 방지
      (layer as Record<string, unknown>)[k] = n;
    }
    refreshOutput();
  });

  layersEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.btn-remove') as HTMLButtonElement;
    if (!btn) return;
    snapshot(); // 실수로 지웠을 때 되돌릴 수 있도록
    layers.splice(Number(btn.dataset.i), 1);
    // 공유 링크로 들어온 경우 주소의 그림자를 먼저 반영한다
  const fromUrl = new URLSearchParams(location.search).get('l');
  if (fromUrl) {
    const parsed = decode(fromUrl);
    if (parsed) layers = parsed;
  }

  render();
  });

  addBtn.addEventListener('click', () => {
    snapshot();
    layers.push({ x: 0, y: 4, blur: 12, spread: 0, color: '#000000', alpha: 0.1, inset: false });
    render();
  });

  undoBtn.addEventListener('click', () => {
    const prev = undoStack.pop();
    if (!prev) return;
    layers = prev;
    undoBtn.disabled = undoStack.length === 0;
    render();
  });

  resetBtn.addEventListener('click', () => {
    snapshot();
    layers = clone(DEFAULT_LAYERS);
    render();
  });

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(output.textContent ?? '');
    copyBtn.textContent = '복사됨';
    setTimeout(() => (copyBtn.textContent = '복사'), 1500);
  });

  // 미리보기 배경(밝게/어둡게) 전환
  const stage = document.getElementById('stage')!;
  document.querySelectorAll<HTMLButtonElement>('.preview-toggle .btn').forEach((b) => {
    b.addEventListener('click', () => {
      stage.dataset.bg = b.dataset.bg!;
      document.querySelectorAll('.preview-toggle .btn').forEach((x) =>
        x.setAttribute('aria-pressed', String(x === b)),
      );
    });
  });

  render();
</script>

<!-- 레이어 행이 JS로 동적 생성되므로 스코프 스타일이 안 먹음 → 전역으로 -->
<style is:global>
  .shadow-layout {
    display: grid;
    /* 같은 이유로 minmax(0,·). 레이어 폼의 min-content가 트랙을 넓히지 못하게 한다 */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: var(--space-5) 0;
  }
  /* 1열에서는 미리보기가 컨트롤 아래로 밀려 값을 조절하는 동안 결과가 안 보인다 */
  .shadow-preview {
    order: -1;
  }
  @media (min-width: 60rem) {
    .shadow-layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
    /* 2열에서는 원래 자리(오른쪽)로 되돌린다 */
    .shadow-preview {
      order: 0;
    }
  }
  .layer-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .layer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .layer-row {
    margin: var(--space-3) 0;
  }
  .layer-row-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .field-inline {
    flex-direction: row !important;
    align-items: center;
    gap: var(--space-2);
  }
  .color-row {
    display: flex;
    gap: var(--space-2);
  }
  .color-row input[type='color'] {
    width: 44px;
    min-width: 44px;
    height: 2.6rem;
    padding: 2px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .shadow-preview {
    position: sticky;
    top: 5rem;
  }
  /* 그림자 가시성을 위해 미리보기 배경은 테마와 무관하게 직접 지정 */
  .preview-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    padding: var(--space-7);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .preview-stage[data-bg='light'] {
    background: #eef0f2;
  }
  .preview-stage[data-bg='light'] #shadow-box {
    background: #ffffff;
  }
  .preview-stage[data-bg='dark'] {
    background: #1c1f26;
  }
  .preview-stage[data-bg='dark'] #shadow-box {
    background: #2b2f3a;
  }
  #shadow-box {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-md);
  }
  .preview-toggle {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .preview-toggle .btn {
    font-size: 0.83rem;
    padding: 0.35rem 0.8rem;
    min-height: 0;
  }
  .preview-toggle .btn[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
