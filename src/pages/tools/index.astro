---
// 도구 전체 목록 (카테고리별 섹션)
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../consts';
import { TOOLS } from '../../tools';

// 도구가 하나라도 있는 카테고리만 순서대로 노출
const sections = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[])
  .map((key) => ({
    key,
    label: CATEGORIES[key],
    tools: TOOLS.filter((t) => t.category === key),
  }))
  .filter((s) => s.tools.length > 0);
---

<Layout title="도구" description="웹 퍼블리셔·디자이너를 위한 프론트엔드 도구 모음">
  <h1>도구</h1>

  {sections.length === 0 && <p>도구를 준비 중입니다.</p>}

  {
    sections.map((section) => (
      <section>
        <h2>{section.label}</h2>
        <ul class="tool-list">
          {section.tools.map((tool) => (
            <li>
              <a href={`/tools/${tool.slug}`}>{tool.title}</a>
              <p>{tool.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

<style>
  .tool-list {
    list-style: none;
    padding: 0;
  }
  .tool-list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .tool-list a {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .tool-list p {
    margin: 4px 0 0;
    color: var(--muted);
  }
</style>
