---
// 도구 전체 목록 (카테고리별 섹션)
import Layout from '../../layouts/Layout.astro';
import SiteSidebar from '../../components/SiteSidebar.astro';
import { CATEGORIES } from '../../consts';
import { TOOLS } from '../../tools';

// 도구가 하나라도 있는 카테고리만 순서대로 노출
const sections = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[])
  .map((key) => ({
    key,
    label: CATEGORIES[key],
    tools: TOOLS.filter((t) => t.category === key),
  }))
  .filter((s) => s.tools.length > 0);
---

<Layout title="도구" description="CSS clamp(), px ↔ rem, box-shadow, 색 대비(WCAG), OG 메타태그, 네이밍 컨벤션까지 브라우저에서 바로 쓰는 무료 프론트엔드 도구 6종. 설치도 로그인도 필요 없습니다." wide sidebar>
  <SiteSidebar slot="sidebar" showTools={false} />

  <h1>도구</h1>
  <p class="tool-intro">필요한 값을 넣으면 바로 결과가 나오는 도구들입니다.</p>

  {sections.length === 0 && <p>도구를 준비 중입니다.</p>}

  {
    sections.map((section) => (
      <section id={section.key}>
        <h2 class="section-label">{section.label}</h2>
        <div class="card-grid">
          {section.tools.map((tool) => (
            <a class="card" href={`/tools/${tool.slug}`}>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
