---
// 도구 전체 목록.
// 카테고리로 쪼개면 섹션 하나에 카드가 한두 장씩만 남는다.
// 한 그리드에 모아 놓고 카테고리는 배지로만 표시한다.
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../consts';
import { TOOLS } from '../../tools';
---

<Layout title="도구" description="CSS clamp(), px ↔ rem, box-shadow, 색 대비(WCAG), OG 메타태그, 네이밍 컨벤션, 색 변환, 그라디언트, 이미지 포맷 변환까지 브라우저에서 바로 쓰는 무료 프론트엔드 도구 9종. 설치도 로그인도 필요 없습니다." wide>
  <h1>도구</h1>
  <p class="tool-intro">필요한 값을 넣으면 바로 결과가 나오는 도구들입니다.</p>

  {TOOLS.length === 0 && <p>도구를 준비 중입니다.</p>}

  <div class="card-grid">
    {
      TOOLS.map((tool) => (
        <a class="card" href={`/tools/${tool.slug}/`}>
          <h2>
            {tool.title} <span class="badge">{CATEGORIES[tool.category]}</span>
          </h2>
          <p>{tool.description}</p>
        </a>
      ))
    }
  </div>
</Layout>
