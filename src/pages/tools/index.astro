---
// 도구 전체 목록 (카테고리별 섹션)
import Layout from '../../layouts/Layout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { CATEGORIES } from '../../consts';
import { TOOLS } from '../../tools';

// 도구가 하나라도 있는 카테고리만 순서대로 노출
const sections = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[])
  .map((key) => ({
    key,
    label: CATEGORIES[key],
    tools: TOOLS.filter((t) => t.category === key),
  }))
  .filter((s) => s.tools.length > 0);
---

<Layout title="도구" description="웹 퍼블리셔·디자이너를 위한 프론트엔드 도구 모음" wide>
  <h1>도구</h1>
  <p class="tool-intro">필요한 값을 넣으면 바로 결과가 나오는 도구들입니다.</p>

  {sections.length === 0 && <p>도구를 준비 중입니다.</p>}

  {sections.length > 1 && <CategoryNav sections={sections} />}

  {
    sections.map((section) => (
      <section id={section.key}>
        <p class="section-label">{section.label}</p>
        <div class="card-grid">
          {section.tools.map((tool) => (
            <a class="card" href={`/tools/${tool.slug}`}>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
