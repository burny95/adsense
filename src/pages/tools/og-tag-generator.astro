---
// Open Graph / meta 태그 생성기
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getTool } from '../../tools';

const tool = getTool('og-tag-generator');

const related = (await getCollection('blog', ({ data }) => !data.draft)).filter(
  (p) => p.data.relatedTools?.includes(tool.slug),
);
---

<Layout title={tool.title} description={tool.description} wide>
  <h1>{tool.title}</h1>
  <p class="tool-intro">{tool.description}</p>

  <form id="og-form" class="panel og-fields">
    <label class="field">
      페이지 제목
      <input class="control" type="text" name="title" value="페이지 제목을 입력하세요" />
      <small class="count" data-for="title" data-max="60"></small>
    </label>
    <label class="field">
      설명
      <textarea class="control" name="description" rows="2"
        >이 페이지가 어떤 내용인지 한두 문장으로 설명합니다.</textarea
      >
      <small class="count" data-for="description" data-max="155"></small>
    </label>
    <label class="field">
      페이지 URL
      <input class="control" type="url" name="url" value="https://example.com/page" />
    </label>
    <label class="field">
      이미지 URL
      <input class="control" type="url" name="image" value="https://example.com/og-image.png" />
      <small>권장 1200×630px, 절대 URL</small>
    </label>
    <label class="field">
      사이트 이름
      <input class="control" type="text" name="siteName" value="사이트 이름" />
    </label>
    <div class="field-grid">
      <label class="field">
        콘텐츠 유형
        <select class="control" name="type">
          <option value="website">website</option>
          <option value="article">article</option>
        </select>
      </label>
      <label class="field">
        트위터 카드
        <select class="control" name="twitterCard">
          <option value="summary_large_image">summary_large_image</option>
          <option value="summary">summary</option>
        </select>
      </label>
      <label class="field">
        로케일
        <input class="control" type="text" name="locale" value="ko_KR" />
      </label>
    </div>
  </form>

  <div class="output">
    <div class="output-head">
      <span>결과 — &lt;head&gt; 안에 붙여넣기</span>
      <button type="button" class="btn" id="copy">복사</button>
    </div>
    <pre><code id="output"></code></pre>
  </div>

  <div class="preview">
    <span class="preview-label">공유 미리보기 — 카카오톡·슬랙 등의 대략적인 모습</span>
    <div class="og-card">
      <div class="og-img empty" id="p-img"></div>
      <div class="og-body">
        <span class="og-domain" id="p-domain"></span>
        <strong id="p-title"></strong>
        <span class="og-desc" id="p-desc"></span>
      </div>
    </div>
  </div>

  <section>
    <h2>사용법</h2>
    <p>
      다섯 개 항목을 채우면 <strong>Open Graph</strong>(<code>og:</code>) 태그와
      <strong>Twitter 카드</strong> 태그를 한꺼번에 생성합니다. 결과를 페이지의
      <code>&lt;head&gt;</code> 안에 넣으면 카카오톡, 슬랙, 페이스북, X(트위터),
      디스코드 등에서 링크를 공유할 때 제목·설명·썸네일이 있는 카드로 표시됩니다.
    </p>
    <p>
      <strong>이미지</strong>는 절대 URL이어야 하며(상대 경로 불가), 1200×630px
      비율을 권장합니다. 너무 작으면 플랫폼이 썸네일 없이 텍스트만 노출합니다.
      <strong>제목</strong>은 약 60자, <strong>설명</strong>은 약 155자를 넘으면
      뒷부분이 잘릴 수 있어 글자 수 안내를 표시합니다.
    </p>
    <p>
      블로그 글·뉴스처럼 작성일이 있는 콘텐츠는 유형을 <code>article</code>로
      두세요. 일반 페이지는 <code>website</code>입니다. 공유 카드가 갱신되지 않을
      때는 각 플랫폼의 디버거로 캐시를 비워야 합니다.
    </p>
  </section>

  {
    related.length > 0 && (
      <aside class="related">
        <h2>관련 글</h2>
        <ul>
          {related.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</Layout>

<script>
  // OG/meta 태그 문자열 생성 (클라이언트에서만 실행)
  const form = document.getElementById('og-form') as HTMLFormElement;
  const output = document.getElementById('output')!;
  const copyBtn = document.getElementById('copy') as HTMLButtonElement;
  const counts = document.querySelectorAll<HTMLElement>('.count');

  const pImg = document.getElementById('p-img')!;
  const pDomain = document.getElementById('p-domain')!;
  const pTitle = document.getElementById('p-title')!;
  const pDesc = document.getElementById('p-desc')!;

  // HTML 속성값에 들어갈 특수문자 이스케이프
  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function domainOf(url: string): string {
    try {
      return new URL(url).hostname.replace(/^www\./, '');
    } catch {
      return '';
    }
  }

  function build() {
    const d = new FormData(form);
    const title = String(d.get('title') ?? '').trim();
    const description = String(d.get('description') ?? '').trim();
    const url = String(d.get('url') ?? '').trim();
    const image = String(d.get('image') ?? '').trim();
    const siteName = String(d.get('siteName') ?? '').trim();
    const type = String(d.get('type') ?? 'website');
    const twitterCard = String(d.get('twitterCard') ?? 'summary_large_image');
    const locale = String(d.get('locale') ?? 'ko_KR').trim();

    const lines = [
      `<title>${esc(title)}</title>`,
      `<meta name="description" content="${esc(description)}" />`,
      url && `<link rel="canonical" href="${esc(url)}" />`,
      ``,
      `<meta property="og:type" content="${esc(type)}" />`,
      `<meta property="og:title" content="${esc(title)}" />`,
      `<meta property="og:description" content="${esc(description)}" />`,
      url && `<meta property="og:url" content="${esc(url)}" />`,
      image && `<meta property="og:image" content="${esc(image)}" />`,
      siteName && `<meta property="og:site_name" content="${esc(siteName)}" />`,
      locale && `<meta property="og:locale" content="${esc(locale)}" />`,
      ``,
      `<meta name="twitter:card" content="${esc(twitterCard)}" />`,
      `<meta name="twitter:title" content="${esc(title)}" />`,
      `<meta name="twitter:description" content="${esc(description)}" />`,
      image && `<meta name="twitter:image" content="${esc(image)}" />`,
    ].filter((l): l is string => typeof l === 'string' && l !== undefined);

    output.textContent = lines.join('\n');

    counts.forEach((el) => {
      const field = el.dataset.for!;
      const max = Number(el.dataset.max);
      const len = String(d.get(field) ?? '').length;
      el.textContent = `${len} / 권장 ${max}자`;
      el.style.color = len > max ? 'var(--danger)' : '';
    });

    pTitle.textContent = title || '(제목 없음)';
    pDesc.textContent = description;
    pDomain.textContent = domainOf(url);
    if (image) {
      pImg.style.backgroundImage = `url("${image.replace(/"/g, '')}")`;
      pImg.classList.remove('empty');
    } else {
      pImg.style.backgroundImage = '';
      pImg.classList.add('empty');
    }
  }

  form.addEventListener('input', build);

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(output.textContent ?? '');
    copyBtn.textContent = '복사됨';
    setTimeout(() => (copyBtn.textContent = '복사'), 1500);
  });

  build();
</script>

<style>
  .og-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .og-card {
    max-width: 480px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }
  .og-img {
    aspect-ratio: 1200 / 630;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-subtle);
  }
  .og-img.empty::after {
    content: '이미지 없음';
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .og-body {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .og-domain {
    font-size: 0.76rem;
    color: var(--muted);
  }
  .og-desc {
    font-size: 0.85rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
