---
// 네이밍 컨벤션 변환기
import ToolPage from '../../layouts/ToolPage.astro';

const formats = [
  { key: 'camel', label: 'camelCase' },
  { key: 'pascal', label: 'PascalCase' },
  { key: 'snake', label: 'snake_case' },
  { key: 'kebab', label: 'kebab-case' },
  { key: 'constant', label: 'CONSTANT_CASE' },
  { key: 'dot', label: 'dot.case' },
];
---

<ToolPage slug="case-converter">
  <form id="case-form" class="panel">
    <label class="field">
      입력 (여러 줄이면 줄마다 변환)
      <textarea class="control" name="input" rows="3" spellcheck="false"
        >user profile id
getUserName
API_BASE_URL</textarea
      >
    </label>
    <div class="form-actions">
      <button type="button" class="btn" id="reset">초기화</button>
      <small>값을 바꾸면 주소도 함께 바뀝니다. 그 주소를 공유하면 같은 값으로 열립니다.</small>
    </div>
  </form>

  <div class="case-results">
    {
      formats.map((f) => (
        <div class="output" data-format={f.key}>
          <div class="output-head">
            <span>{f.label}</span>
            <button type="button" class="btn btn-copy" data-format={f.key}>
              복사
            </button>
          </div>
          <code class="output-code result" />
        </div>
      ))
    }
  </div>

  <section class="prose">
    <h2>사용법</h2>
    <p>
      아무 형식으로나 이름을 입력하면 여섯 가지 표기법으로 한 번에 바꿉니다.
      공백, 하이픈(<code>-</code>), 밑줄(<code>_</code>), 점(<code>.</code>),
      그리고 <code>camelCase</code>의 대소문자 경계를 모두 단어 구분으로 인식합니다.
      여러 줄을 넣으면 줄 단위로 변환하고, 각 형식의 결과 전체를 복사할 수 있습니다.
    </p>
    <p>
      쓰임새: API 응답의 <code>snake_case</code> 키를 프론트엔드
      <code>camelCase</code>로 옮길 때, 디자인 토큰 이름을 CSS 변수
      <code>--kebab-case</code>로 바꿀 때, 상수 목록을
      <code>CONSTANT_CASE</code>로 정리할 때 등입니다.
    </p>
  </section>

  <section class="prose">
    <h2>실제 응용</h2>

    <h3>어디에 무엇을 쓰는가</h3>
    <p>
      표기법은 취향이 아니라 자리마다 굳어진 관례입니다. 관례를 따르면 이름만 보고도
      그게 무엇인지 짐작할 수 있습니다.
    </p>
    <table class="data-table">
      <thead>
        <tr><th>표기법</th><th>쓰는 자리</th></tr>
      </thead>
      <tbody>
        <tr><td><code>camelCase</code></td><td>JS·TS의 변수와 함수, 객체 속성, JSON 키(프론트엔드 쪽)</td></tr>
        <tr><td><code>PascalCase</code></td><td>클래스, 타입·인터페이스, React 컴포넌트와 그 파일명</td></tr>
        <tr><td><code>kebab-case</code></td><td>CSS 클래스와 변수, HTML 속성, URL 경로, 대부분의 파일명</td></tr>
        <tr><td><code>snake_case</code></td><td>DB 컬럼과 테이블, 파이썬·루비 변수, 백엔드 API의 JSON 키</td></tr>
        <tr><td><code>CONSTANT_CASE</code></td><td>상수, 환경변수(<code>.env</code>), 열거형 멤버</td></tr>
        <tr><td><code>dot.case</code></td><td>i18n 번역 키, 설정 파일의 중첩 경로</td></tr>
      </tbody>
    </table>
    <p>
      경계에서 표기법이 바뀌는 지점이 실무의 대부분입니다. DB는
      <code>snake_case</code>, 프론트엔드는 <code>camelCase</code>인 상황이
      가장 흔합니다.
    </p>

    <h3>여러 줄을 한꺼번에 옮기는 게 진짜 쓸모</h3>
    <p>
      이름 하나를 바꾸는 건 손으로도 됩니다. 이 도구가 시간을 아껴 주는 순간은
      <strong>목록을 통째로 옮길 때</strong>입니다. DB 스키마의 컬럼 목록을 그대로
      붙여넣고 camelCase 결과를 복사하면, 타입 정의의 뼈대가 한 번에 나옵니다.
    </p>
    <pre><code>{`# 입력 (DB 컬럼 목록을 그대로 붙여넣기)
user_id
created_at
is_active
last_login_at
profile_image_url

# camelCase 결과
userId
createdAt
isActive
lastLoginAt
profileImageUrl`}</code></pre>
    <p>
      반대 방향도 같습니다. 프론트엔드에서 쓰던 필드 이름을 붙여넣고 snake_case
      결과를 가져가면 마이그레이션 파일에 그대로 넣을 수 있습니다.
    </p>

    <h3>약어는 원래 모양으로 돌아오지 않는다</h3>
    <p>
      이 도구를 쓰기 전에 알아 둬야 할 한 가지입니다. 변환 과정에서 단어를 전부
      소문자로 내렸다가 다시 조립하기 때문에, <strong>연속된 대문자 약어는 원형이
      유지되지 않습니다.</strong>
    </p>
    <table class="data-table">
      <thead>
        <tr><th>입력</th><th>kebab-case</th><th>다시 camelCase</th></tr>
      </thead>
      <tbody>
        <tr><td><code>userID</code></td><td><code>user-id</code></td><td><code>userId</code></td></tr>
        <tr><td><code>parseURLPath</code></td><td><code>parse-url-path</code></td><td><code>parseUrlPath</code></td></tr>
        <tr><td><code>getHTTPResponseCode</code></td><td><code>get-http-response-code</code></td><td><code>getHttpResponseCode</code></td></tr>
      </tbody>
    </table>
    <p>
      이게 문제인지 아닌지는 팀 규칙에 달렸습니다. 구글 자바스크립트 스타일 가이드를
      비롯해 <strong>약어도 일반 단어처럼 쓰도록(<code>userId</code>) 정한 규칙이
      많고</strong>, 그런 팀에서는 오히려 원하는 결과가 나옵니다. 반대로 약어를
      대문자로 유지하는 규칙이라면 변환 후 그 부분만 손으로 되돌려야 합니다.
    </p>
    <p>
      <code>iOSDevice</code>처럼 소문자로 시작하는 약어는
      <code>i-os-device</code>가 되어 의도와 크게 달라집니다. 이런 이름은 변환에
      맡기지 말고 직접 쓰는 편이 낫습니다.
    </p>

    <h3>숫자가 붙는 위치를 확인한다</h3>
    <p>
      숫자는 <strong>앞 단어에 붙습니다.</strong> <code>grid2Col</code>은
      <code>grid2</code>와 <code>col</code>로, <code>h1Title</code>은
      <code>h1</code>과 <code>title</code>로 나뉩니다. 대부분 의도한 대로지만,
      <code>v2Endpoint</code>를 <code>v-2-endpoint</code>로 만들고 싶었다면
      결과가 다릅니다(<code>v2-endpoint</code>). 숫자가 들어간 이름은 결과를
      한 번 확인하고 쓰세요.
    </p>
  </section>
</ToolPage>

<script>
  import {
    defaultsOf,
    applyParams,
    syncParams,
    resetForm,
  } from '../../scripts/tool-state';

  // 네이밍 표기법 변환 (클라이언트에서만 실행)
  const form = document.getElementById('case-form') as HTMLFormElement;
  const input = form.elements.namedItem('input') as HTMLTextAreaElement;
  const blocks = document.querySelectorAll<HTMLElement>('.case-results .output');

  // 한 개의 식별자를 소문자 단어 배열로 분해
  function tokenize(raw: string): string[] {
    return raw
      .trim()
      .replace(/([a-z0-9])([A-Z])/g, '$1 $2') // camel 경계
      .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2') // 연속 대문자 뒤 단어
      .split(/[\s\-_.]+/)
      .filter(Boolean)
      .map((w) => w.toLowerCase());
  }

  const converters: Record<string, (w: string[]) => string> = {
    camel: (w) =>
      w
        .map((x, i) => (i === 0 ? x : x[0].toUpperCase() + x.slice(1)))
        .join(''),
    pascal: (w) => w.map((x) => x[0].toUpperCase() + x.slice(1)).join(''),
    snake: (w) => w.join('_'),
    kebab: (w) => w.join('-'),
    constant: (w) => w.join('_').toUpperCase(),
    dot: (w) => w.join('.'),
  };

  function convert() {
    const lines = input.value.split('\n');
    blocks.forEach((block) => {
      const fmt = block.dataset.format!;
      const fn = converters[fmt];
      const out = lines
        .map((line) => (line.trim() ? fn(tokenize(line)) : ''))
        .join('\n');
      block.querySelector('.result')!.textContent = out;
      // 변환 결과가 없으면 복사할 것도 없다
      const copy = block.querySelector<HTMLButtonElement>('.btn-copy');
      if (copy) copy.disabled = out.trim() === '';
    });
  }

  const KEYS = ['input'];
  const defaults = defaultsOf(form, KEYS);
  const resetBtn = document.getElementById('reset') as HTMLButtonElement;

  form.addEventListener('input', () => {
    syncParams(form, KEYS, defaults);
    convert();
  });

  resetBtn.addEventListener('click', () => {
    resetForm(form, defaults);
    convert();
  });

  // 공유 링크로 들어온 경우 주소의 값을 먼저 반영한다
  applyParams(form, KEYS);

  document.querySelectorAll<HTMLButtonElement>('.btn-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('.output')!;
      await navigator.clipboard.writeText(
        block.querySelector('.result')!.textContent ?? '',
      );
      btn.textContent = '복사됨';
      setTimeout(() => (btn.textContent = '복사'), 1500);
    });
  });

  convert();
</script>

<style>
  .case-results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0;
  }
  .case-results .output {
    margin: 0;
  }
  .case-results .output-code {
    min-height: 3rem;
  }
</style>
