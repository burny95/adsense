---
// 블로그 글 목록
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../consts';

// 발행된 글만, 최신순 정렬
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const dateFmt = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' });
---

<Layout title="블로그" description="프론트엔드 도구 사용법과 실무 팁">
  <h1>블로그</h1>
  <p class="tool-intro">도구를 제대로 쓰기 위한 배경지식과 실무 팁.</p>

  {posts.length === 0 && <p>첫 번째 글을 준비 중입니다.</p>}

  <ul class="stack-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <p class="post-meta">
            <span class="badge">{CATEGORIES[post.data.category]}</span>
            {' '}
            {dateFmt.format(post.data.publishedAt)}
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>
