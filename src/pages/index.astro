---
// 홈 페이지
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, CATEGORIES } from '../consts';
import { TOOLS } from '../tools';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5);
---

<Layout>
  <h1>{SITE_NAME}</h1>
  <p>
    웹 퍼블리셔·디자이너가 실무에서 자주 쓰는 프론트엔드 도구와, 그 도구를
    제대로 쓰기 위한 가이드를 모아둔 곳입니다.
  </p>

  <h2>도구</h2>
  <ul class="list">
    {
      TOOLS.map((tool) => (
        <li>
          <a href={`/tools/${tool.slug}`}>{tool.title}</a>
          <span class="tag">{CATEGORIES[tool.category]}</span>
          <p>{tool.description}</p>
        </li>
      ))
    }
  </ul>
  <p><a href="/tools">도구 전체 보기 →</a></p>

  {
    recentPosts.length > 0 && (
      <>
        <h2>최근 글</h2>
        <ul class="list">
          {recentPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/blog">블로그 전체 보기 →</a>
        </p>
      </>
    )
  }
</Layout>

<style>
  .list {
    list-style: none;
    padding: 0;
  }
  .list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .list a {
    font-weight: 600;
  }
  .list p {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .tag {
    margin-left: 8px;
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
  }
</style>
