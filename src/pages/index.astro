---
// 홈 페이지
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, SITE_DESCRIPTION, CATEGORIES } from '../consts';
import { TOOLS } from '../tools';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5);
---

<Layout>
  <h1>{SITE_NAME}</h1>
  <p class="tool-intro">{SITE_DESCRIPTION}</p>

  <p class="section-label">도구</p>
  <div class="card-grid">
    {
      TOOLS.map((tool) => (
        <a class="card" href={`/tools/${tool.slug}`}>
          <h3>
            {tool.title} <span class="badge">{CATEGORIES[tool.category]}</span>
          </h3>
          <p>{tool.description}</p>
        </a>
      ))
    }
  </div>
  <p><a href="/tools">도구 전체 보기 →</a></p>

  {
    recentPosts.length > 0 && (
      <>
        <p class="section-label">최근 글</p>
        <ul class="stack-list">
          {recentPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/blog">블로그 전체 보기 →</a>
        </p>
      </>
    )
  }
</Layout>
