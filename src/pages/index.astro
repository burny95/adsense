---
// 홈 페이지: 사이트 소개 + 최근 글 + 두 섹션 바로가기
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { postHref } from '../posts';

// 공개된 글을 최신순으로 8편
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 8);
---

<Layout
  description="현업 웹 퍼블리셔가 직접 겪은 일을 바탕으로 쓴 CSS·마크업 실무 가이드와, 클로드·클로드 코드를 처음 쓰는 분을 위한 사용법."
>
  <h1>웹 퍼블리셔의 실무 가이드와 클로드 사용법</h1>
  <p class="tool-intro">
    현업 퍼블리셔가 작업하면서 실제로 걸렸던 것들을 정리합니다. CSS·색·이미지·마크업
    실무 글은 <a href="/blog/">블로그</a>에, 클로드와 클로드 코드를 처음 쓰는 분을 위한
    글은 <a href="/claude/">클로드</a>에 있습니다.
  </p>

  {
    recentPosts.length > 0 && (
      <>
        <h2 class="section-label">최근 글</h2>
        <ul class="stack-list">
          {recentPosts.map((post) => (
            <li>
              <a href={postHref(post)}>{post.data.title}</a>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/blog/">블로그 전체 보기 →</a> · <a href="/claude/">클로드 글 전체 보기 →</a>
        </p>
      </>
    )
  }
</Layout>
