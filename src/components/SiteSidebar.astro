---
// 좌측 사이드바 — 도구는 전체 목록, 블로그는 카테고리별로.
// 도구·블로그 양쪽의 목록 페이지와 상세 페이지에서 공통으로 사용한다.
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../consts';
import { TOOLS } from '../tools';

interface Props {
  showTools?: boolean; // 본문이 이미 도구 전체를 보여주는 페이지(홈·/tools)에서는 끈다
  activeTool?: string; // 현재 보고 있는 도구 slug를 강조
  activeCategory?: keyof typeof CATEGORIES; // 현재 글의 카테고리를 강조
}
const { showTools = true, activeTool, activeCategory } = Astro.props;

// 발행된 글만 세어서 카테고리별 글 수를 낸다
const posts = await getCollection('blog', ({ data }) => !data.draft);

// 글이 하나라도 있는 카테고리만, 각 카테고리의 글 수와 함께
const categories = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[])
  .map((key) => ({
    key,
    label: CATEGORIES[key],
    count: posts.filter((p) => p.data.category === key).length,
  }))
  .filter((c) => c.count > 0);
---

<div class="site-side">
  {/* 랜드마크를 둘로 나눠 보조기술에서 각각 제 이름으로 읽히게 한다 */}
  {
    showTools && (
      <nav class="side-block" aria-label="도구">
        <p class="side-head">
          <a href="/tools">도구</a>
        </p>
        <ul class="side-list">
          {TOOLS.map((t) => (
            <li>
              <a
                href={`/tools/${t.slug}`}
                aria-current={t.slug === activeTool ? 'page' : undefined}
              >
                {t.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <nav class="side-block" aria-label="블로그 카테고리">
    <p class="side-head"><a href="/blog">블로그</a></p>
    <ul class="side-list">
      <li>
        <a href="/blog">전체 <span class="side-count">{posts.length}</span></a>
      </li>
      {
        categories.map((c) => (
          <li>
            <a
              href={`/blog#${c.key}`}
              aria-current={c.key === activeCategory ? 'true' : undefined}
            >
              {c.label} <span class="side-count">{c.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
