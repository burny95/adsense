---
// 모든 페이지가 공유하는 기본 레이아웃 (head 메타, 헤더, 푸터)
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  NAV_LINKS,
  SITE_LIVE,
  VERIFICATION,
} from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import { TOOLS } from '../tools';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean; // 도구 페이지처럼 넓은 본문이 필요할 때
  ogType?: string; // 기본 website, 글은 article
  schema?: object | object[]; // 페이지별 JSON-LD (도구=SoftwareApplication, 글=Article 등)
}

const {
  title,
  description = SITE_DESCRIPTION,
  wide = false,
  ogType = 'website',
  schema,
} = Astro.props;

// 페이지 제목: 개별 제목이 있으면 "제목 | 사이트명", 없으면 사이트명만
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

// 현재 경로 (네비게이션 활성 표시에 사용, 하위 경로도 활성 처리)
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

// 검색엔진 색인용 정규 URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// 모든 페이지 공통 구조화 데이터 (사이트 정보 + 검색창)
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  description: SITE_DESCRIPTION,
  inLanguage: 'ko-KR',
};
const schemaList = [siteSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FF7A1A" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} 블로그`}
      href="/rss.xml"
    />

    {/* 저장된 테마를 페인트 전에 적용해 깜빡임(FOUC) 방지 */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark')
            document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/* 완성 전까지 검색엔진 색인 차단 (consts.ts의 SITE_LIVE) */}
    {!SITE_LIVE && <meta name="robots" content="noindex, nofollow" />}

    {/* 검색엔진 소유확인 */}
    {
      VERIFICATION.naver && (
        <meta name="naver-site-verification" content={VERIFICATION.naver} />
      )
    }

    <!-- 소셜 공유 미리보기 -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* 구조화 데이터 (JSON-LD) */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemaList.length === 1 ? schemaList[0] : schemaList)}
    />

    <!-- 애드센스 승인 후 여기에 구글이 제공한 광고 스크립트를 삽입 -->
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>

    <header class="site-header">
      <div class:list={['container', { wide }]}>
        <a class="site-title" href="/">{SITE_NAME}</a>
        <nav aria-label="주요 메뉴">
          {
            NAV_LINKS.map((link) => (
              <a
                href={link.href}
                class:list={{ 'nav-secondary': link.secondary }}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle class="theme-toggle--header" />
      </div>
    </header>

    <script is:inline>
      // 이벤트 위임: 헤더·푸터 어느 토글 버튼을 눌러도 동작 (푸터는 이 시점에 아직 미파싱)
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.theme-toggle')) return;
        var root = document.documentElement;
        var current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>

    <main id="main">
      <div class:list={['container', { wide }]}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class:list={['container', { wide }]}>
        {/* 전체 도구·페이지 목록 (사이드바 대신 어느 페이지에서든 전체 접근) */}
        <nav class="footer-sitemap" aria-label="사이트맵">
          <div class="footer-col">
            <p class="footer-head"><a href="/tools">도구</a></p>
            <ul>
              {
                TOOLS.map((tool) => (
                  <li>
                    <a href={`/tools/${tool.slug}`}>{tool.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-head">사이트</p>
            <ul>
              <li><a href="/blog">블로그</a></li>
              <li><a href="/about">소개</a></li>
              <li><a href="/contact">문의</a></li>
              <li><a href="/privacy">개인정보처리방침</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </div>
        </nav>
        <div class="footer-bottom">
          <span>© {year} {SITE_NAME}</span>
          <ThemeToggle class="theme-toggle--footer" />
        </div>
      </div>
    </footer>
  </body>
</html>
