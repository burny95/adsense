---
// 모든 페이지가 공유하는 기본 레이아웃 (head 메타, 헤더, 푸터)
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  NAV_LINKS,
  SITE_LIVE,
  VERIFICATION,
} from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean; // 도구 페이지처럼 넓은 본문이 필요할 때
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;

// 페이지 제목: 개별 제목이 있으면 "제목 | 사이트명", 없으면 사이트명만
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

// 현재 경로 (네비게이션 활성 표시에 사용, 하위 경로도 활성 처리)
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

// 검색엔진 색인용 정규 URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/* 완성 전까지 검색엔진 색인 차단 (consts.ts의 SITE_LIVE) */}
    {!SITE_LIVE && <meta name="robots" content="noindex, nofollow" />}

    {/* 검색엔진 소유확인 */}
    {
      VERIFICATION.naver && (
        <meta name="naver-site-verification" content={VERIFICATION.naver} />
      )
    }

    <!-- 소셜 공유 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- 애드센스 승인 후 여기에 구글이 제공한 광고 스크립트를 삽입 -->
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>

    <header class="site-header">
      <div class:list={['container', { wide }]}>
        <a class="site-title" href="/">{SITE_NAME}</a>
        <nav aria-label="주요 메뉴">
          {
            NAV_LINKS.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <div class:list={['container', { wide }]}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class:list={['container', { wide }]}>
        <span>© {year} {SITE_NAME}</span>
        <nav aria-label="하단 메뉴">
          <a href="/about">소개</a>
          <a href="/contact">문의</a>
          <a href="/privacy">개인정보처리방침</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
